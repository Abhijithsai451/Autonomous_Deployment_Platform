{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "title": "Agent Runtime & Telemetry Overview",
  "uid": "agent-runtime-overview",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Agent Execution Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(cortexops_agent_runs_total[5m])) by (status) or sum(increase(cortexops_agent_runs_total[5m])) by (status)",
          "legendFormat": "{{agent_type}} - {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Execution Latency (Seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(cortexops_agent_execution_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "LLM Token Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(cortexops_llm_tokens_total[5m])) by (token_type, model) or sum(increase(cortexops_llm_tokens_total[5m]))",
          "legendFormat": "{{model}} - {{token_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Live Agent Logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=~\".+\"} |= \"Agent\""
        }
      ]
    }
  ]
}